// Xadiis App - Prisma schema (PostgreSQL)
// Tables use snake_case names via @@map; columns use snake_case via @map.

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum UserRole {
  USER
  EDITOR
  REVIEWER
  ADMIN

  @@map("user_role")
}

enum HadithStatus {
  DRAFT
  PENDING_REVIEW
  PUBLISHED
  ARCHIVED

  @@map("hadith_status")
}

enum ContentStatus {
  DRAFT
  PENDING_REVIEW
  PUBLISHED
  ARCHIVED

  @@map("content_status")
}

enum MemorizationStatus {
  NEW
  LEARNING
  REVIEWING
  MEMORIZED

  @@map("memorization_status")
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED

  @@map("review_status")
}

// ---------------------------------------------------------------------------
// Religious content
// ---------------------------------------------------------------------------

model HadithBook {
  id                String   @id @default(uuid()) @db.Uuid
  slug              String   @unique
  nameArabic        String   @map("name_arabic")
  nameSomali        String   @map("name_somali")
  nameEnglish       String   @map("name_english")
  authorName        String   @map("author_name")
  descriptionSomali String?  @map("description_somali")
  sortOrder         Int      @default(0) @map("sort_order")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  chapters HadithChapter[]
  hadiths  Hadith[]

  @@index([sortOrder])
  @@map("hadith_books")
}

model HadithChapter {
  id           String   @id @default(uuid()) @db.Uuid
  bookId       String   @map("book_id") @db.Uuid
  number       Int
  titleArabic  String?  @map("title_arabic")
  titleSomali  String?  @map("title_somali")
  titleEnglish String?  @map("title_english")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  book    HadithBook @relation(fields: [bookId], references: [id], onDelete: Cascade)
  hadiths Hadith[]

  @@unique([bookId, number])
  @@index([bookId])
  @@map("hadith_chapters")
}

model Hadith {
  id                   String       @id @default(uuid()) @db.Uuid
  bookId               String       @map("book_id") @db.Uuid
  chapterId            String?      @map("chapter_id") @db.Uuid
  hadithNumber         String       @map("hadith_number")
  /// Numeric part of hadith_number (e.g. "52a" -> 52), maintained by the service for natural sorting.
  hadithNumberSort     Int          @default(0) @map("hadith_number_sort")
  arabicText           String       @map("arabic_text")
  /// Arabic text with tashkeel/tatweel removed and letter variants unified; maintained by the service for search.
  arabicTextNormalized String       @default("") @map("arabic_text_normalized")
  narrator             String?
  sourceReference      String?      @map("source_reference")
  status               HadithStatus @default(DRAFT)
  publishedAt          DateTime?    @map("published_at") @db.Timestamptz(3)
  createdById          String?      @map("created_by") @db.Uuid
  createdAt            DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  book         HadithBook          @relation(fields: [bookId], references: [id], onDelete: Restrict)
  chapter      HadithChapter?      @relation(fields: [chapterId], references: [id], onDelete: SetNull)
  createdBy    User?               @relation("HadithCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  translations HadithTranslation[]
  gradings     HadithGrading[]
  explanations HadithExplanation[]
  categories   HadithCategory[]
  bookmarks    Bookmark[]
  memorization MemorizationProgress[]
  readings     ReadingHistory[]

  @@unique([bookId, hadithNumber])
  @@index([bookId])
  @@index([chapterId])
  @@index([status])
  @@index([hadithNumber])
  @@index([bookId, hadithNumberSort])
  @@map("hadiths")
}

model HadithTranslation {
  id         String        @id @default(uuid()) @db.Uuid
  hadithId   String        @map("hadith_id") @db.Uuid
  language   String        @db.VarChar(10)
  text       String
  translator String?
  source     String?
  status     ContentStatus @default(DRAFT)
  createdAt  DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  hadith Hadith @relation(fields: [hadithId], references: [id], onDelete: Cascade)

  @@index([hadithId])
  @@index([language, status])
  @@map("hadith_translations")
}

model HadithGrading {
  id        String   @id @default(uuid()) @db.Uuid
  hadithId  String   @map("hadith_id") @db.Uuid
  grade     String
  gradedBy  String?  @map("graded_by")
  source    String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  hadith Hadith @relation(fields: [hadithId], references: [id], onDelete: Cascade)

  @@index([hadithId])
  @@map("hadith_gradings")
}

model HadithExplanation {
  id        String        @id @default(uuid()) @db.Uuid
  hadithId  String        @map("hadith_id") @db.Uuid
  language  String        @db.VarChar(10)
  text      String
  author    String?
  source    String?
  status    ContentStatus @default(DRAFT)
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  hadith Hadith @relation(fields: [hadithId], references: [id], onDelete: Cascade)

  @@index([hadithId])
  @@index([language, status])
  @@map("hadith_explanations")
}

model Category {
  id          String   @id @default(uuid()) @db.Uuid
  slug        String   @unique
  nameSomali  String   @map("name_somali")
  nameArabic  String   @map("name_arabic")
  nameEnglish String   @map("name_english")
  icon        String?
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  hadiths HadithCategory[]

  @@index([sortOrder])
  @@map("categories")
}

model HadithCategory {
  hadithId   String   @map("hadith_id") @db.Uuid
  categoryId String   @map("category_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  hadith   Hadith   @relation(fields: [hadithId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([hadithId, categoryId])
  @@index([categoryId])
  @@map("hadith_categories")
}

// ---------------------------------------------------------------------------
// Users
// ---------------------------------------------------------------------------

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  passwordHash String   @map("password_hash")
  role         UserRole @default(USER)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  profile              Profile?
  notificationSettings UserNotificationSettings?
  refreshTokens        RefreshToken[]
  bookmarks            Bookmark[]
  memorization         MemorizationProgress[]
  readingHistory       ReadingHistory[]
  createdHadiths       Hadith[]                @relation("HadithCreatedBy")
  submittedReviews     ContentReview[]         @relation("ReviewSubmittedBy")
  reviewedReviews      ContentReview[]         @relation("ReviewReviewedBy")
  changes              ContentChangeHistory[]
  adminRoles           AdminRole[]

  @@map("users")
}

model Profile {
  id                String   @id @default(uuid()) @db.Uuid
  userId            String   @unique @map("user_id") @db.Uuid
  displayName       String   @map("display_name") @db.VarChar(80)
  preferredLanguage String   @default("so") @map("preferred_language") @db.VarChar(5)
  theme             String   @default("system") @db.VarChar(20)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("profiles")
}

model RefreshToken {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  /// SHA-256 hex digest of the opaque token. The raw token is never stored.
  tokenHash  String    @unique @map("token_hash")
  familyId   String    @map("family_id") @db.Uuid
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(3)
  replacedBy String?   @map("replaced_by") @db.Uuid
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

model Bookmark {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  hadithId  String   @map("hadith_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  hadith Hadith @relation(fields: [hadithId], references: [id], onDelete: Cascade)

  @@unique([userId, hadithId])
  @@index([hadithId])
  @@map("bookmarks")
}

model MemorizationProgress {
  id             String             @id @default(uuid()) @db.Uuid
  userId         String             @map("user_id") @db.Uuid
  hadithId       String             @map("hadith_id") @db.Uuid
  status         MemorizationStatus @default(NEW)
  repetitions    Int                @default(0)
  easeFactor     Float              @default(2.5) @map("ease_factor")
  intervalDays   Int                @default(0) @map("interval_days")
  nextReviewAt   DateTime?          @map("next_review_at") @db.Timestamptz(3)
  lastReviewedAt DateTime?          @map("last_reviewed_at") @db.Timestamptz(3)
  createdAt      DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  hadith Hadith @relation(fields: [hadithId], references: [id], onDelete: Cascade)

  @@unique([userId, hadithId])
  @@index([userId, status])
  @@index([userId, nextReviewAt])
  @@index([hadithId])
  @@map("memorization_progress")
}

model ReadingHistory {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  hadithId  String   @map("hadith_id") @db.Uuid
  viewedAt  DateTime @default(now()) @map("viewed_at") @db.Timestamptz(3)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  hadith Hadith @relation(fields: [hadithId], references: [id], onDelete: Cascade)

  @@unique([userId, hadithId])
  @@index([userId, viewedAt])
  @@index([hadithId])
  @@map("reading_history")
}

model UserNotificationSettings {
  id              String   @id @default(uuid()) @db.Uuid
  userId          String   @unique @map("user_id") @db.Uuid
  dailyHadith     Boolean  @default(true) @map("daily_hadith")
  reviewReminders Boolean  @default(true) @map("review_reminders")
  reminderTime    String   @default("08:00") @map("reminder_time") @db.VarChar(5)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_notification_settings")
}

// ---------------------------------------------------------------------------
// Content administration
// ---------------------------------------------------------------------------

model ContentReview {
  id            String       @id @default(uuid()) @db.Uuid
  entityType    String       @map("entity_type") @db.VarChar(40)
  entityId      String       @map("entity_id") @db.Uuid
  status        ReviewStatus @default(PENDING)
  submittedById String       @map("submitted_by") @db.Uuid
  reviewedById  String?      @map("reviewed_by") @db.Uuid
  notes         String?
  reviewedAt    DateTime?    @map("reviewed_at") @db.Timestamptz(3)
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  submittedBy User  @relation("ReviewSubmittedBy", fields: [submittedById], references: [id], onDelete: Restrict)
  reviewedBy  User? @relation("ReviewReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([entityType, entityId])
  @@map("content_reviews")
}

model ContentChangeHistory {
  id          String   @id @default(uuid()) @db.Uuid
  entityType  String   @map("entity_type") @db.VarChar(40)
  entityId    String   @map("entity_id") @db.Uuid
  action      String   @db.VarChar(40)
  changedById String?  @map("changed_by") @db.Uuid
  before      Json?
  after       Json?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  changedBy User? @relation(fields: [changedById], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@map("content_change_history")
}

/// Optional granular role grants. The `users.role` enum is the primary source of
/// authorization; this table is reserved for future fine-grained grants.
model AdminRole {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  role      UserRole
  scope     String?  @db.VarChar(80)
  grantedBy String?  @map("granted_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, role, scope])
  @@map("admin_roles")
}
