# ---------------------------------------------------------------------------
# Xadiis App API - environment variables (placeholders only, never commit real values)
# Copy to .env for local development.
# ---------------------------------------------------------------------------

# PostgreSQL connection string (required).
# In Coolify use the INTERNAL hostname of the PostgreSQL resource, e.g.
# postgresql://xadiis:<password>@<coolify-postgres-internal-host>:5432/xadiis
DATABASE_URL=postgresql://xadiis:change-me@localhost:5432/xadiis

PORT=3000
NODE_ENV=production

# Access-token signing secret (required, >= 32 chars). Generate with:
#   openssl rand -base64 48
JWT_ACCESS_SECRET=replace-with-output-of-openssl-rand-base64-48
# Access token lifetime in seconds (default 900 = 15 min)
JWT_ACCESS_TTL=900
# Refresh token lifetime in days (default 30)
JWT_REFRESH_TTL_DAYS=30

# Comma-separated browser origins allowed by CORS. Leave empty to disable CORS
# (the mobile app does not need it), e.g. https://admin.example.com
CORS_ORIGINS=

# Set to true when running behind a reverse proxy (Coolify/Traefik) so rate
# limiting uses the real client IP from X-Forwarded-For.
TRUST_PROXY=true

# Optional rate limits (requests per minute per IP)
# THROTTLE_LIMIT=120
# AUTH_THROTTLE_LIMIT=5

# Optional: run `npm run seed:prod` with these set to create an ADMIN user.
# Remove them from the environment after the first seed.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
